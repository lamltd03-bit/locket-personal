#!name=Locket Gold Personal💛
#!desc=tson208

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/lamltd03-bit/locket-personal/main/Locket.js, requires-body=true, max-size=-1, timeout=60
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/lamltd03-bit/locket-personal/main/del_header.js, timeout=60
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/lamltd03-bit/locket-personal/main/Locket_Unlocked_Clean.js, requires-body=true, max-size=-1, timeout=60
locket_rc_us = type=http-request, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/lamltd03-bit/locket-personal/main/Locket_rc_us.js, timeout=10

[MITM]
hostname = %APPEND% api.revenuecat.com, raw.githubusercontent.com, firebaseremoteconfig.googleapis.com
